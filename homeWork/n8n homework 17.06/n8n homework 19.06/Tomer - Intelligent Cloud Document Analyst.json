    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "GEMINI_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  contents: [\n    {\n      parts: [\n        {\n          text:\n            \"You are a cybersecurity document intelligence assistant.\\n\\n\" +\n            \"Analyze the following cybersecurity document and return ONLY a valid JSON object.\\n\" +\n            \"Do not include markdown.\\n\" +\n            \"Do not include explanations outside the JSON.\\n\" +\n            \"Do not wrap the JSON in backticks.\\n\\n\" +\n            \"Return exactly this JSON structure:\\n\\n\" +\n            \"{\\n\" +\n            \"  \\\"summary\\\": \\\"2-3 sentence summary of the cybersecurity document\\\",\\n\" +\n            \"  \\\"classification\\\": \\\"one of: phishing_alert, malware_alert, vulnerability_report, suspicious_login, incident_summary, other\\\",\\n\" +\n            \"  \\\"sentiment\\\": \\\"one of: positive, neutral, negative\\\",\\n\" +\n            \"  \\\"entities\\\": {\\n\" +\n            \"    \\\"people\\\": [],\\n\" +\n            \"    \\\"organizations\\\": [],\\n\" +\n            \"    \\\"dates\\\": [],\\n\" +\n            \"    \\\"amounts\\\": [],\\n\" +\n            \"    \\\"ips\\\": [],\\n\" +\n            \"    \\\"domains\\\": [],\\n\" +\n            \"    \\\"emails\\\": [],\\n\" +\n            \"    \\\"systems\\\": [],\\n\" +\n            \"    \\\"cves\\\": []\\n\" +\n            \"  },\\n\" +\n            \"  \\\"action_items\\\": [],\\n\" +\n            \"  \\\"confidence_score\\\": 0.0\\n\" +\n            \"}\\n\\n\" +\n            \"Classification rules:\\n\" +\n            \"- phishing_alert: suspicious emails, fake login pages, credential theft attempts\\n\" +\n            \"- malware_alert: malware, trojans, ransomware, suspicious files or processes\\n\" +\n            \"- vulnerability_report: CVEs, outdated software, missing patches, weak configurations\\n\" +\n            \"- suspicious_login: brute force, unusual login, VPN login, account compromise\\n\" +\n            \"- incident_summary: general security incident summary\\n\" +\n            \"- other: anything that does not clearly match the above\\n\\n\" +\n            \"Document metadata:\\n\" +\n            \"Filename: \" + $json.filename + \"\\n\" +\n            \"File type: \" + $json.file_type + \"\\n\\n\" +\n            \"Document text:\\n\" +\n            $json.text\n        }\n      ]\n    }\n  ],\n  generationConfig: {\n    temperature: 0.2,\n    responseMimeType: \"application/json\"\n  }\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1184,
        336
      ],
      "id": "9c54a365-9bbf-49f1-bc3e-74e30ddd54a6",
      "name": "Gemini Analysis",
      "retryOnFail": true,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "function getGeminiText(response) {\n  const text = response?.candidates?.[0]?.content?.parts?.[0]?.text;\n\n  if (!text || typeof text !== \"string\") {\n    throw new Error(\"Gemini response does not contain candidates[0].content.parts[0].text\");\n  }\n\n  return text;\n}\n\n\nfunction parseGeminiJson(rawText) {\n  let cleaned = rawText\n    .replace(/```json/gi, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  try {\n    return JSON.parse(cleaned);\n  } catch (firstError) {\n    const firstBrace = cleaned.indexOf(\"{\");\n    const lastBrace = cleaned.lastIndexOf(\"}\");\n\n    if (firstBrace === -1 || lastBrace === -1 || lastBrace <= firstBrace) {\n      throw new Error(\"Could not find a valid JSON object in Gemini response\");\n    }\n\n    const jsonOnly = cleaned.slice(firstBrace, lastBrace + 1);\n\n    try {\n      return JSON.parse(jsonOnly);\n    } catch (secondError) {\n      throw new Error(\"Failed to parse Gemini JSON: \" + secondError.message);\n    }\n  }\n}\n\n\nfunction ensureArray(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n\n  if (value === undefined || value === null || value === \"\") {\n    return [];\n  }\n\n  return [String(value)];\n}\n\n\nfunction normalizeEntities(entities) {\n  const safeEntities = entities && typeof entities === \"object\" ? entities : {};\n\n  return {\n    people: ensureArray(safeEntities.people),\n    organizations: ensureArray(safeEntities.organizations),\n    dates: ensureArray(safeEntities.dates),\n    amounts: ensureArray(safeEntities.amounts),\n    ips: ensureArray(safeEntities.ips),\n    domains: ensureArray(safeEntities.domains),\n    emails: ensureArray(safeEntities.emails),\n    systems: ensureArray(safeEntities.systems),\n    cves: ensureArray(safeEntities.cves)\n  };\n}\n\n\nfunction normalizeClassification(value) {\n  const allowed = [\n    \"phishing_alert\",\n    \"malware_alert\",\n    \"vulnerability_report\",\n    \"suspicious_login\",\n    \"incident_summary\",\n    \"other\"\n  ];\n\n  if (allowed.includes(value)) {\n    return value;\n  }\n\n  return \"other\";\n}\n\n\nfunction normalizeSentiment(value) {\n  const allowed = [\"positive\", \"neutral\", \"negative\"];\n\n  if (allowed.includes(value)) {\n    return value;\n  }\n\n  return \"neutral\";\n}\n\n\nconst inputItems = $input.all();\nconst editFieldsItems = $items(\"Edit Fields\");\nconst downloadItems = $items(\"Download file\");\n\nreturn inputItems.map((item, index) => {\n  const rawGeminiText = getGeminiText(item.json);\n  const geminiData = parseGeminiJson(rawGeminiText);\n\n  const editFieldsData = editFieldsItems[index]?.json || editFieldsItems[0]?.json || {};\n  const downloadBinaryData = downloadItems[index]?.binary?.data || downloadItems[0]?.binary?.data || {};\n\n  const confidenceScore = Number(geminiData.confidence_score);\n\n  return {\n    json: {\n      summary: String(geminiData.summary || \"\"),\n      classification: normalizeClassification(geminiData.classification),\n      sentiment: normalizeSentiment(geminiData.sentiment),\n      entities: normalizeEntities(geminiData.entities),\n      action_items: ensureArray(geminiData.action_items),\n      confidence_score: Number.isFinite(confidenceScore) ? confidenceScore : 0.0,\n      filename: editFieldsData.filename || downloadBinaryData.fileName || \"unknown_file\",\n      file_type: editFieldsData.file_type || downloadBinaryData.fileExtension || \"unknown\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1408,
        336
      ],
      "id": "0ab1b5b6-0ace-4c91-9b0c-27050d617f1a",
      "name": "Parse Gemini JSON"
