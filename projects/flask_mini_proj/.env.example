# --- AWS credentials (Bedrock Runtime generation only) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Bedrock Runtime model (generation) ---
# If empty or access-denied, the fallbacks below are tried automatically.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# BEDROCK_MODEL_FALLBACKS=amazon.nova-micro-v1:0,anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=1200
BEDROCK_TEMPERATURE=0.3

# --- Local FAISS retrieval ---
# Embedding backend: "tfidf" (default, lightweight, no torch) or
# "sentence_transformers" (needs requirements-ml.txt: sentence-transformers + torch).
EMBEDDING_BACKEND=tfidf
# Used only when EMBEDDING_BACKEND=sentence_transformers:
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RETRIEVAL_TOP_K=5
# Minimum similarity for a chunk to count as relevant (drops zero-overlap hits).
RETRIEVAL_MIN_SCORE=0.01

# --- Bedrock Knowledge Base (DEMO/SCREENSHOTS ONLY, not used at runtime) ---
# Used only by bedrock_kb_demo.py. Leave blank for normal app operation.
KNOWLEDGE_BASE_ID=

# --- Flask ---
FLASK_DEBUG=false
FLASK_SECRET_KEY=change-me-in-production
