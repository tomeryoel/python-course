# --- AWS region ---
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# --- Bedrock Agent (primary chat path) ---
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=

# --- Bedrock Knowledge Base + S3 (RAG source) ---
BEDROCK_KNOWLEDGE_BASE_ID=
# Backward-compatible alias:
KNOWLEDGE_BASE_ID=
S3_BUCKET_NAME=
S3_PREFIX=data/

# --- Lambda tools (MCP-style Action Groups + optional direct demo endpoints) ---
WEEKLY_SNAPSHOT_LAMBDA_NAME=ptsd-weekly-wellness-snapshot
EMERGENCY_CALL_LAMBDA_NAME=ptsd-emergency-contact-voice-call
EMERGENCY_CONTACT_PHONE=+972XXXXXXXXX

# --- Amazon Connect (Emergency Call Lambda env — set on Lambda, not Flask) ---
# CONNECT_INSTANCE_ID=
# CONNECT_CONTACT_FLOW_ID=
# CONNECT_SOURCE_PHONE_NUMBER=

# --- Bedrock Runtime (auxiliary: task extraction only — NOT /api/chat) ---
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_MAX_TOKENS=1200
BEDROCK_TEMPERATURE=0.3

# --- Legacy local FAISS (disabled by default) ---
ENABLE_LEGACY_FAISS=false

# --- Flask ---
FLASK_DEBUG=false
FLASK_SECRET_KEY=change-me-in-production

# --- Optional local credentials (EC2 should use IAM role instead) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
