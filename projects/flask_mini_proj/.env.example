# AWS credentials (use IAM user/role with Bedrock + Knowledge Base access)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Bedrock Knowledge Base (from AWS Console → Knowledge bases)
KNOWLEDGE_BASE_ID=

# Primary model; if empty or denied, fallbacks are tried automatically
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Optional comma-separated fallback models (tried after BEDROCK_MODEL_ID)
# BEDROCK_MODEL_FALLBACKS=amazon.nova-micro-v1:0,anthropic.claude-3-haiku-20240307-v1:0

RETRIEVAL_TOP_K=5
BEDROCK_MAX_TOKENS=1200
BEDROCK_TEMPERATURE=0.3

# Flask (production)
FLASK_DEBUG=false
FLASK_SECRET_KEY=change-me-in-production
